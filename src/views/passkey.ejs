<%- include('partials/header') %>

<main class="main-content">
  <div class="container">
    <div class="page-header">
      <div class="step-indicator">
        <span class="step done">1. Validate Invitation</span>
        <span class="step-sep">&rarr;</span>
        <% if (assuranceMode === 'verified-id') { %>
          <span class="step done">2. Present Partner ID</span>
          <span class="step-sep">&rarr;</span>
        <% } %>
        <span class="step done"><%= assuranceMode === 'verified-id' ? '3' : '2' %>. Sign in with TAP</span>
        <span class="step-sep">&rarr;</span>
        <span class="step active"><%= assuranceMode === 'verified-id' ? '4' : '3' %>. Register Passkey</span>
      </div>
      <h1 class="page-title">Register and Confirm Tenant Passkey</h1>
      <p class="page-subtitle">
        Microsoft Graph supplies the Entra-compatible creation options and accepts the
        resulting public key credential. The portal never substitutes its own production challenge.
      </p>
    </div>

    <div id="globalError" class="alert alert-error hidden" role="alert"></div>

    <div class="card">
      <h2 class="card-section-title">Recommended browser flow</h2>
      <ol class="instructions-list">
        <li>Open Microsoft Security info and sign in with the one-time TAP.</li>
        <li>Add a passkey or FIDO2 security key in the Microsoft-hosted registration experience.</li>
        <li>Return here and select <strong>Check registration</strong>.</li>
      </ol>
      <p>
        <a href="<%= securityInfoUrl %>" class="btn btn-primary" target="_blank" rel="noopener">
          Open Microsoft Security info
        </a>
      </p>
    </div>

    <div class="card mt-md">
      <h2 class="card-section-title">Graph provisioning API</h2>
      <p>
        This path calls <code>creationOptions</code>, invokes WebAuthn, submits the
        credential to Graph, and confirms the created method. Browsers will block it
        when Entra returns a relying-party ID that is not valid for this portal origin.
      </p>
      <div class="form-group">
        <label for="displayName" class="form-label">Passkey display name</label>
        <input id="displayName" class="form-input" value="Onboarding passkey" maxlength="64">
      </div>
      <div class="form-actions">
        <button class="btn btn-secondary" id="registerPasskeyBtn" onclick="registerPasskey()"
          <%- passkeyRegistered ? 'disabled' : '' %>>
          Register using Graph options
        </button>
        <button class="btn btn-primary" id="confirmPasskeyBtn" onclick="confirmPasskey()"
          <%- passkeyRegistered ? 'disabled' : '' %>>
          Check registration
        </button>
      </div>
      <div class="passkey-status mt-md" id="registrationStatus">
        <% if (passkeyRegistered) { %>
          <span class="status-registered">&#10003; Tenant passkey confirmed</span>
        <% } else { %>
          <span class="status-not-registered">&#9675; No confirmed tenant passkey</span>
        <% } %>
      </div>
    </div>

    <div class="passkey-complete-section" id="completeSection">
      <% if (passkeyRegistered) { %>
        <a href="/passkey/complete" class="btn btn-success btn-large">Complete Onboarding &rarr;</a>
      <% } else { %>
        <button class="btn btn-success btn-large" disabled>
          Complete Onboarding &mdash; confirm a tenant passkey first
        </button>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
