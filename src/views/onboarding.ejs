<% if (activateFromFragment) { %>
<script src="/js/invitation.js"></script>
<script>
InvitationActivation.activateFromCurrentFragment().catch(function(error) {
  document.addEventListener('DOMContentLoaded', function() {
    var status = document.getElementById('invitationActivationStatus');
    if (status) {
      status.textContent = error.message;
      status.classList.remove('hidden');
    }
  });
});
</script>
<% } %>

<%- include('partials/header') %>

<main class="main-content">
  <div class="container">
    <div class="page-header">
      <div class="step-indicator">
        <span class="step active">1. Validate Invitation</span>
        <span class="step-sep">&rarr;</span>
        <span class="step">2. Sign in with TAP</span>
        <span class="step-sep">&rarr;</span>
        <span class="step">3. Register Passkey</span>
      </div>
      <h1 class="page-title"><%= invitationActive ? 'Validate Your Invitation' : 'Manager-Approved Invitation Required' %></h1>
      <p class="page-subtitle">
        The first-release pilot starts from a one-time link created after manager approval
        and bound to a specific pre-created Entra object ID.
      </p>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-error" role="alert">
        <ul>
          <% errors.forEach(function(error) { %><li><%= error %></li><% }); %>
        </ul>
      </div>
    <% } %>

    <% if (invitationActive) { %>
      <div class="card form-card">
        <form method="POST" action="/onboarding/invite" id="invitationForm" novalidate>
          <div class="form-group">
            <label for="personalEmail" class="form-label">
              Personal Email Address <span class="required">*</span>
            </label>
            <input
              type="email"
              id="personalEmail"
              name="personalEmail"
              class="form-input"
              required
              autocomplete="email"
            >
            <p class="form-hint">Enter the personal email address used for the approved invitation.</p>
          </div>

          <div class="form-group">
            <label for="employeeId" class="form-label">
              Employee Identifier <span class="required">*</span>
            </label>
            <input
              type="text"
              id="employeeId"
              name="employeeId"
              class="form-input"
              required
              autocomplete="off"
            >
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary" id="submitBtn">
              Validate and create one-time TAP
            </button>
          </div>
        </form>
      </div>

      <div class="info-box">
        <h3>Invitation protections</h3>
        <ul>
          <li>The account is selected by immutable Entra object ID before the link is created.</li>
          <li>The server stores only a SHA-256 hash of the opaque invitation token.</li>
          <li>The link expires, limits failed validation attempts, and can be consumed once.</li>
          <li>The Temporary Access Pass is created only after the known email and employee ID match.</li>
        </ul>
      </div>
    <% } else { %>
      <div class="card">
        <% if (activateFromFragment) { %>
          <div id="invitationActivationStatus" class="alert alert-error hidden" role="alert"></div>
          <p>Validating the manager-approved invitation...</p>
        <% } else { %>
        <p>
          Ask the pilot approver to complete the manager approval workflow and send the
          generated invitation to the known personal email address.
        </p>
        <% if (demoMode) { %>
          <p><a href="/onboarding/demo" class="btn btn-secondary">Create local demo invitation</a></p>
          <p class="form-hint">Demo values: demo.user@personal.example and DEMO-001.</p>
        <% } %>
        <% } %>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>

<% if (invitationActive) { %>
<script>
document.getElementById('invitationForm').addEventListener('submit', function() {
  document.getElementById('submitBtn').disabled = true;
  document.getElementById('submitBtn').textContent = 'Consuming invitation...';
});
</script>
<% } %>
