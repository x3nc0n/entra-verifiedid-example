<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>
  <main class="main-content">
    <div class="container">
      <div class="page-header">
        <h1 class="page-title">Manager Invitation</h1>
        <p class="page-subtitle">
          Complete the employee verification step to continue manager-initiated onboarding.
        </p>
      </div>

      <section class="card" id="employeeInvitePanel" data-activated="<%= activated ? 'true' : 'false' %>">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } else if (!activated) { %>
          <p id="employeeInviteActivationStatus" aria-live="polite">Validating your invitation link...</p>
        <% } else { %>
          <div class="alert alert-info">
            Confirm the invited employee identity for
            <strong><%= request?.employeeDisplayName || 'this onboarding request' %></strong>.
          </div>
          <form id="employeeInviteForm">
            <div class="form-group">
              <label class="form-label" for="userPrincipalName">Tenant user principal name</label>
              <input id="userPrincipalName" name="userPrincipalName" class="form-input" type="email" maxlength="254" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="employeeId">Employee ID</label>
              <input id="employeeId" name="employeeId" class="form-input" type="text" maxlength="64" required>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Verify employee identity</button>
            </div>
          </form>
          <p id="employeeInviteStatus" class="mt-md" aria-live="polite"></p>
        <% } %>
      </section>
    </div>
  </main>
  <%- include('partials/footer') %>
  <script src="/js/v2-onboarding-invite.js" defer></script>
</body>
</html>
