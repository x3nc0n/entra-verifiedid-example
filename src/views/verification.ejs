<%- include('partials/header') %>

<main class="main-content">
  <div class="container">
    <div class="page-header">
      <div class="step-indicator">
        <span class="step done">1. Match User</span>
        <span class="step-sep">&rarr;</span>
        <span class="step active">2. Present Partner ID</span>
        <span class="step-sep">&rarr;</span>
        <span class="step">3. Sign in with TAP</span>
        <span class="step-sep">&rarr;</span>
        <span class="step">4. Register Passkey</span>
      </div>
      <h1 class="page-title">Present Partner-Issued Verified ID</h1>
      <p class="page-subtitle">
        Present the credential issued by the configured identity-proofing partner.
        The verified subject must match <strong><%= user.userPrincipalName %></strong>.
      </p>
    </div>

    <div class="two-col" id="verificationContent">
      <div class="qr-panel card">
        <div class="qr-status-bar">
          <span class="status-dot status-waiting" id="statusDot"></span>
          <span id="statusText">Creating presentation request...</span>
        </div>
        <div class="qr-container" id="qrContainer">
          <div class="qr-placeholder" id="qrPlaceholder"><div class="spinner"></div></div>
        </div>
        <div class="qr-actions hidden" id="qrActions">
          <a href="#" id="qrLink" class="btn btn-secondary btn-small" target="_blank">
            Open in Authenticator
          </a>
        </div>
      </div>

      <div class="instructions-panel">
        <h2 class="instructions-title">Verification checks</h2>
        <ol class="instructions-list">
          <li>The Verified ID service validates the credential signature, revocation, and linked domain.</li>
          <li>The portal enforces the configured credential type and partner issuer DID.</li>
          <li>The configured subject claims must exactly match the pre-created Entra user.</li>
          <li>Only then does the portal create a one-time Temporary Access Pass.</li>
        </ol>
        <div id="errorMessage" class="alert alert-error hidden"></div>
      </div>
    </div>

    <div class="card hidden" id="tapPanel">
      <h2 class="card-section-title">Temporary Access Pass</h2>
      <div class="alert alert-warning">
        This value is shown once. Copy it now. The portal does not store it in your session.
      </div>
      <p><code id="tapValue"></code></p>
      <p id="tapLifetime"></p>
      <div class="form-actions">
        <button class="btn btn-secondary" id="copyTapBtn" type="button">Copy TAP</button>
        <a class="btn btn-primary" id="signInLink" target="_blank" rel="noopener">
          Sign in and register at Microsoft
        </a>
        <a class="btn btn-success" href="/passkey">Continue to passkey confirmation</a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script>
(async function initVerification() {
  var pollInterval = null;

  function setStatus(text, type) {
    document.getElementById('statusText').textContent = text;
    document.getElementById('statusDot').className = 'status-dot status-' + type;
  }

  function showError(message) {
    setStatus('Verification failed.', 'error');
    document.getElementById('errorMessage').textContent = message;
    document.getElementById('errorMessage').classList.remove('hidden');
  }

  try {
    var response = await fetch('/api/verification/request', { method: 'POST' });
    var data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Failed to create presentation request.');

    document.getElementById('qrPlaceholder').classList.add('hidden');
    if (data.qrCode) {
      var image = document.createElement('img');
      image.src = data.qrCode.indexOf('data:') === 0
        ? data.qrCode
        : 'data:image/png;base64,' + data.qrCode;
      image.alt = 'Verified ID presentation QR code';
      document.getElementById('qrContainer').appendChild(image);
    } else {
      var linkHint = document.createElement('p');
      linkHint.textContent = 'Open the presentation link on a device with Microsoft Authenticator.';
      document.getElementById('qrContainer').appendChild(linkHint);
    }

    document.getElementById('qrLink').href = data.url;
    document.getElementById('qrActions').classList.remove('hidden');
    setStatus('Waiting for partner credential presentation...', 'waiting');

    pollInterval = setInterval(async function() {
      var statusResponse = await fetch('/api/verification/status/' + data.requestId);
      var status = await statusResponse.json();

      if (status.status === 'request_retrieved') {
        setStatus('Credential retrieved; verifying...', 'active');
      } else if (status.status === 'tap_created') {
        clearInterval(pollInterval);
        setStatus('Identity matched and TAP created.', 'success');
        document.getElementById('verificationContent').classList.add('hidden');
        document.getElementById('tapPanel').classList.remove('hidden');
        document.getElementById('tapValue').textContent = status.temporaryAccessPass;
        document.getElementById('tapLifetime').textContent =
          'One-time pass, valid for ' + status.lifetimeInMinutes + ' minutes.';
        document.getElementById('signInLink').href = status.signInUrl;
      } else if (status.status === 'tap_delivered') {
        clearInterval(pollInterval);
        showError(status.message);
      } else if (status.status === 'presentation_error' || status.status === 'tap_error') {
        clearInterval(pollInterval);
        showError(status.message || 'Credential verification failed.');
      }
    }, 2000);

    document.getElementById('copyTapBtn').addEventListener('click', async function() {
      await navigator.clipboard.writeText(document.getElementById('tapValue').textContent);
      this.textContent = 'Copied';
    });
  } catch (err) {
    if (pollInterval) clearInterval(pollInterval);
    showError(err.message);
  }
})();
</script>
