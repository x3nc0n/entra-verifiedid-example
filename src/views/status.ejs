<main class="main-content">
  <div class="container">
    <section class="card">
      <h1 class="page-title"><%= heading || title %></h1>
      <% const statusError = typeof error !== 'undefined' ? error : null; %>
      <div class="alert alert-error"><%= statusError ? statusError.message : message %></div>
      <% if (message && (!statusError || message !== statusError.message)) { %>
        <p><%= message %></p>
      <% } %>
      <% if (actionHref && actionLabel) { %>
        <p><a class="btn btn-primary" href="<%= actionHref %>"><%= actionLabel %></a></p>
      <% } %>
    </section>
  </div>
</main>
