# Application
NODE_ENV=development
PORT=3000
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true

# Microsoft Entra and runtime managed identity
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<runtime-managed-identity-client-id>
AZURE_CLIENT_SECRET=
AZURE_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
PILOT_GROUP_ID=<pilot-group-object-id>

# Durable Azure Table state
ONBOARDING_STATE_BACKEND=memory
AZURE_STORAGE_TABLE_ENDPOINT=https://<storage-account>.table.core.windows.net
ONBOARDING_SESSIONS_TABLE=onboardingSessions
ONBOARDING_V2_REQUESTS_TABLE=onboardingV2Requests

# Shared Verified ID request-service scope
VC_SERVICE_SCOPE=3db474b9-6a0c-4840-96ac-1fceb342124f/.default

# v2 request, retry, and rate-limit policy
V2_REQUEST_LIFETIME_MINUTES=1440
V2_MANAGER_TOKEN_LIFETIME_MINUTES=1440
V2_MANAGER_PREAUTH_LIFETIME_MINUTES=10
V2_MAX_DAILY_REQUESTS_PER_UPN=3
V2_MAX_DAILY_REQUESTS_PER_IP=10
V2_MAX_DAILY_REQUESTS_PER_EMPLOYEE=3
V2_MAX_PASSKEY_CONFIRM_ATTEMPTS=30
V2_MAX_ISSUANCE_RETRIES=3
V2_MAX_PRESENTATION_RETRIES=3
V2_MAX_VERIFICATION_FAILURES=3

# Base64-encoded 32-byte key used only to protect transient v2 PIN/TAP values.
V2_TRANSIENT_PROTECTION_KEY=

# Dedicated single-tenant manager OIDC application
V2_MANAGER_OIDC_CLIENT_ID=<manager-oidc-app-client-id>
V2_MANAGER_OIDC_CLIENT_SECRET=
V2_MANAGER_OIDC_REDIRECT_URI=https://<portal-host>/auth/manager/callback

# Dedicated v2 Verified ID contract
V2_VERIFIED_ID_AUTHORITY=<tenant-authority-did>
V2_VERIFIED_ID_MANIFEST_URL=https://<verified-id-manifest-url>
V2_VERIFIED_ID_CREDENTIAL_TYPE=<dedicated-v2-credential-type>
V2_VERIFIED_ID_OBJECT_ID_CLAIM=<object-id-claim-path>
V2_VERIFIED_ID_EMPLOYEE_ID_CLAIM=<employee-id-claim-path>
V2_VERIFIED_ID_LINKED_DOMAIN=<verified-linked-domain>
V2_VERIFIED_ID_CALLBACK_API_KEY=
V2_VERIFIED_ID_ISSUANCE_PIN_LENGTH=6

# Manager notification: noop for local tests, acs for live delivery.
V2_MANAGER_NOTIFICATION_PROVIDER=noop

# ACS Email prefers managed identity when the HTTPS endpoint is set.
V2_ACS_EMAIL_ENDPOINT=https://<communication-resource>.communication.azure.com
V2_ACS_EMAIL_SENDER_ADDRESS=<verified-sender-address>

# Secret fallback only when managed-identity access is unavailable.
V2_ACS_EMAIL_CONNECTION_STRING=

# TAP handoff destination
TAP_LIFETIME_MINUTES=60
ENTRA_SECURITY_INFO_URL=https://mysignins.microsoft.com/security-info

# Demo-only local WebAuthn values
FIDO2_RP_NAME=Entra Verified ID Demo
FIDO2_RP_ID=localhost
FIDO2_ORIGIN=http://localhost:3000
KEY_VAULT_URL=
